# ---- dependencies (不可入库) ----
node_modules/
**/node_modules/

# ---- python ----
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# ---- next / ts build ----
.next/
out/
*.tsbuildinfo

# ---- env & secrets ----
.env
.env.*
!.env.example

# ---- runtime ----
logs/
*.log

# ---- os ----
.DS_Store
Thumbs.db

# ---- 含个人/第三方身份信息的文档（不随公开仓发布；仓库仅保留脱敏提炼 md）----
doc/*.doc
doc/*.docx

# ---- Agent 工作记忆（不入库）----
# .workbuddy/memory/ 是 AI 会话的长期记忆与每日工作日志，可能包含本机绝对路径、
# 其他项目的内部名称、以及未经脱敏的第三方信息。它属于本地工作状态，不属于项目产物。
# 注：本规则只阻止新增；此前已提交的历史文件需要单独决定是否摘出索引。
.workbuddy/memory/
.workbuddy/logs/
.workbuddy/sessions/
.workbuddy/cache/
